import urllib.request
import urllib.error
y = 0
with open("wordlist.txt") as f:
    words = f.read().splitlines()


for w in words:
    url = "http://localhost:8080/" + w
    try:
        r = urllib.request.urlopen(url)
        if r.status == 200: 
            print("[+]",w)
            y += 1
    except urllib.error.HTTPError as e:
        pass
print("一共发现了",y,"个存在的路径")


